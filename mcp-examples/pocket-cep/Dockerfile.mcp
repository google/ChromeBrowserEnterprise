# Dockerfile for CEP MCP Server
FROM mirror.gcr.io/library/node:20-alpine

WORKDIR /app

# Install directly from the public npm registry
RUN npm install @google/chrome-enterprise-premium-mcp@latest

# Expose the port the MCP server will listen on
EXPOSE 4000

# Run in SSE/HTTP mode (GCP_STDIO=false)
ENV GCP_STDIO=false
ENV PORT=4000
ENV LOG_LEVEL=warn

# Run the installed package directly using node
CMD ["node", "node_modules/@google/chrome-enterprise-premium-mcp/mcp-server.js"]
